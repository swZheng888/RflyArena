<?xml version="1.0"?>
<launch>
    <!-- =============================================== -->
    <!-- RflySim + RL Controller 联合仿真启动文件       -->
    <!-- 参考 nmpc_control/launch/rflysim_nmpc.launch   -->
    <!-- =============================================== -->

    <!-- ==================== 基本配置 ==================== -->
    <arg name="copter_id" default="1" />

    <!-- ==================== 坐标系配置 ==================== -->
    <arg name="frame_id" default="map" />
    <arg name="child_frame_id" default="base_link" />

    <!-- ==================== 话题配置 ==================== -->
    <arg name="odom_topic" default="/vio/odometry_enu" />
    <arg name="position_cmd_topic" default="/position_cmd" />
    <arg name="attitude_cmd_topic" default="/mavros/setpoint_raw/attitude" />

    <!-- ==================== RL 模型配置 ==================== -->
    <arg name="model_path" default="/root/trajectory_project/src/rl_control/model/w4.onnx"/>

    <!-- ==================== 控制器参数 ==================== -->
    <arg name="control_rate"       default="100"    doc="控制频率 Hz (对齐训练env decimation=2)"/>
    <arg name="thrust_range"       default="0.3"    doc="油门动作范围 ± (训练env=0.3)"/>
    <arg name="max_roll_rate"      default="3.84"   doc="最大滚转角速率 rad/s (220°/s)"/>
    <arg name="max_pitch_rate"     default="3.84"   doc="最大俯仰角速率 rad/s (220°/s)"/>
    <arg name="max_yaw_rate"       default="3.49"   doc="最大偏航角速率 rad/s (200°/s)"/>

    <!-- ==================== Sim2Real 滤波参数 ==================== -->
    <!-- 对齐训练env: motor_time_constant=0.04s / ang_vel_cmd_time_constant=0.02s -->
    <arg name="throttle_filter_tau" default="0.04"  doc="油门EMA滤波τ(s), 对齐训练motor_time_constant"/>
    <arg name="ang_vel_filter_tau"  default="0.02"  doc="角速度EMA滤波τ(s), 对齐训练ang_vel_cmd_time_constant"/>

    <!-- ==================== 起飞参数 ==================== -->
    <arg name="takeoff_height"     default="1.0"    doc="起飞目标高度 m"/>
    <arg name="takeoff_vz_max"     default="0.5"    doc="最大上升速度 m/s"/>
    <arg name="takeoff_dist_thr"   default="0.15"   doc="起飞到位判断阈值 m"/>
    <arg name="start_threshold"    default="0.3"    doc="到达轨迹起点阈值 m"/>
    <arg name="skip_takeoff"       default="false"  doc="跳过起飞阶段"/>

    <!-- ==================== 调试 ==================== -->
    <arg name="debug_flag"         default="0"      doc="1=开启 RViz 可视化话题"/>

    <!-- ==================== 节点启动 ==================== -->

    <!-- 1. RflySim 里程计节点 (复用 nmpc_control 的 odom 节点) -->
    <node pkg="nmpc_control" type="rflysim_odom_node.py" name="rflysim_odom_node" output="screen">
        <param name="copter_id" value="$(arg copter_id)" />
        <param name="rate" value="200.0" />
        <param name="frame_id" value="$(arg frame_id)" />
        <param name="child_frame_id" value="$(arg child_frame_id)" />
        <param name="odom_topic" value="/vio/odometry" />
        <param name="odom_enu_topic" value="/vio/odometry_enu" />
    </node>

    <!-- 2. RL 控制节点 -->
    <node pkg="rl_control" type="control_rl_node.py" name="control_rl_node" output="screen" required="true">
        <param name="model_path"          value="$(arg model_path)"/>
        <param name="odom_topic"          value="$(arg odom_topic)"/>
        <param name="position_cmd_topic"  value="$(arg position_cmd_topic)"/>
        <param name="attitude_cmd_topic"  value="$(arg attitude_cmd_topic)"/>

        <param name="control_rate"        value="$(arg control_rate)"     type="int"/>
        <param name="thrust_range"        value="$(arg thrust_range)"     type="double"/>
        <param name="max_roll_rate"       value="$(arg max_roll_rate)"    type="double"/>
        <param name="max_pitch_rate"      value="$(arg max_pitch_rate)"   type="double"/>
        <param name="max_yaw_rate"        value="$(arg max_yaw_rate)"     type="double"/>

        <param name="takeoff_height"      value="$(arg takeoff_height)"   type="double"/>
        <param name="takeoff_vz_max"      value="$(arg takeoff_vz_max)"   type="double"/>
        <param name="takeoff_dist_thr"    value="$(arg takeoff_dist_thr)" type="double"/>
        <param name="start_threshold"     value="$(arg start_threshold)"  type="double"/>
        <param name="skip_takeoff"        value="$(arg skip_takeoff)"     type="bool"/>

        <param name="debug_flag"          value="$(arg debug_flag)"       type="int"/>

        <!-- Sim2Real 滤波 -->
        <param name="throttle_filter_tau" value="$(arg throttle_filter_tau)" type="double"/>
        <param name="ang_vel_filter_tau"  value="$(arg ang_vel_filter_tau)"  type="double"/>
    </node>

</launch>
