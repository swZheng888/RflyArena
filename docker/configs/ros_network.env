#############################################################################
# ROS 网络配置
# 用于 Docker 容器与宿主机 ROS 通信
#############################################################################

# ROS Master URI
# - 如果仿真器在宿主机运行，使用 host.docker.internal
# - 如果使用 docker-compose，使用服务名 roscore
ROS_MASTER_URI=http://host.docker.internal:11311

# 容器 ROS IP
# - 使用 --network host 时，填写宿主机 IP
# - 使用桥接网络时，Docker 会自动分配
ROS_IP=

# ROS 域 ID (ROS2 专用，此项目使用 ROS1 忽略)
# ROS_DOMAIN_ID=0

# ROS 日志级别
ROSCONSOLE_FORMAT=[${severity}] [${time}] [${node}]: ${message}
